{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok-Now",
  "version": "1.0.0",
  "identifier": "com.tiktoknow.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "@benedictusrey",
    "shortDescription": "TikTok-Now Desktop Application by @benedictusrey",
    "longDescription": "TikTok-Now is a high-performance cross-platform desktop application for TikTok (https://www.tiktok.com), authored and created by @benedictusrey."
  },
  "plugins": {}
}
